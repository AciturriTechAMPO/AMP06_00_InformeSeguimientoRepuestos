    <ui:InvokeCode ContinueOnError="{x:Null}" Code="&#xD;&#xA;Try&#xD;&#xA;&#xD;&#xA;    ' ======================================================&#xD;&#xA;    ' 1. LECTURA ORIGINAL DEL EXCEL - SIN MODIFICACIONES&#xD;&#xA;    ' ======================================================&#xD;&#xA;&#xD;&#xA;    Dim strConex As String = &quot;Provider=Microsoft.ACE.OLEDB.12.0;Data Source=&quot; &amp; in_RutaExcel &amp; &quot;;Extended Properties='Excel 12.0 Xml;HDR=Yes;IMEX=1';&quot;&#xD;&#xA;&#xD;&#xA;    Dim dtTemporal As New System.Data.DataTable()&#xD;&#xA;&#xD;&#xA;    Using conexion As New System.Data.OleDb.OleDbConnection(strConex)&#xD;&#xA;&#xD;&#xA;        conexion.Open()&#xD;&#xA;&#xD;&#xA;        Dim dtEsquema As System.Data.DataTable = conexion.GetOleDbSchemaTable(System.Data.OleDb.OleDbSchemaGuid.Tables, Nothing)&#xD;&#xA;&#xD;&#xA;        Dim nombreHoja As String = dtEsquema.Rows(0)(&quot;TABLE_NAME&quot;).ToString()&#xD;&#xA;&#xD;&#xA;        Dim query As String = &quot;SELECT * FROM [&quot; &amp; nombreHoja &amp; &quot;]&quot;&#xD;&#xA;&#xD;&#xA;        Using comando As New System.Data.OleDb.OleDbCommand(query, conexion)&#xD;&#xA;&#xD;&#xA;            Using adaptador As New System.Data.OleDb.OleDbDataAdapter(comando)&#xD;&#xA;&#xD;&#xA;                adaptador.Fill(dtTemporal)&#xD;&#xA;&#xD;&#xA;            End Using&#xD;&#xA;&#xD;&#xA;        End Using&#xD;&#xA;&#xD;&#xA;    End Using&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ' ======================================================&#xD;&#xA;    ' 2. VALIDAR ESTRUCTURA ORIGINAL&#xD;&#xA;    ' ======================================================&#xD;&#xA;&#xD;&#xA;    If dtTemporal.Columns.Count &lt;&gt; 17 Then&#xD;&#xA;&#xD;&#xA;        Dim nombres As New System.Text.StringBuilder()&#xD;&#xA;&#xD;&#xA;        For Each col As System.Data.DataColumn In dtTemporal.Columns&#xD;&#xA;            nombres.Append(&quot;[&quot; &amp; col.ColumnName &amp; &quot;] &quot;)&#xD;&#xA;        Next&#xD;&#xA;&#xD;&#xA;        Throw New Exception(&#xD;&#xA;            &quot;Se esperaban 17 columnas y OLEDB devolvió &quot; &amp;&#xD;&#xA;            dtTemporal.Columns.Count.ToString() &amp;&#xD;&#xA;            &quot;. Columnas: &quot; &amp; nombres.ToString())&#xD;&#xA;&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ' ======================================================&#xD;&#xA;    ' 3. CREAR DATATABLE FINAL CON 16 COLUMNAS&#xD;&#xA;    ' ======================================================&#xD;&#xA;&#xD;&#xA;    Dim dtFinal As New System.Data.DataTable()&#xD;&#xA;&#xD;&#xA;    Dim columnasFinales As String() = {&#xD;&#xA;        &quot;Proveedor Inicial&quot;,&#xD;&#xA;        &quot;¿Calidad 3_0?&quot;,&#xD;&#xA;        &quot;Ped. Compra&quot;,&#xD;&#xA;        &quot;Pos. Compra&quot;,&#xD;&#xA;        &quot;Comp.Type&quot;,&#xD;&#xA;        &quot;Material&quot;,&#xD;&#xA;        &quot;Estado Doc.&quot;,&#xD;&#xA;        &quot;Fecha Validación&quot;,&#xD;&#xA;        &quot;Proveedor&quot;,&#xD;&#xA;        &quot;Colada(s)&quot;,&#xD;&#xA;        &quot;Operación&quot;,&#xD;&#xA;        &quot;Desc. Operación&quot;,&#xD;&#xA;        &quot;Ped. Venta&quot;,&#xD;&#xA;        &quot;Pos. Venta&quot;,&#xD;&#xA;        &quot;Calidad&quot;,&#xD;&#xA;        &quot;Cantidad&quot;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    For Each nombre As String In columnasFinales&#xD;&#xA;&#xD;&#xA;        dtFinal.Columns.Add(nombre, GetType(String))&#xD;&#xA;&#xD;&#xA;    Next&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ' ======================================================&#xD;&#xA;    ' 4. TRANSFORMAR REGISTROS POR ÍNDICE ORIGINAL&#xD;&#xA;    ' ======================================================&#xD;&#xA;&#xD;&#xA;    For Each fila As System.Data.DataRow In dtTemporal.Rows&#xD;&#xA;&#xD;&#xA;        Dim nuevaFila As System.Data.DataRow = dtFinal.NewRow()&#xD;&#xA;&#xD;&#xA;        ' Proveedor original: columna H (índice 7)&#xD;&#xA;        Dim proveedor As String = fila(7).ToString().Trim()&#xD;&#xA;&#xD;&#xA;        nuevaFila(0) = proveedor&#xD;&#xA;        nuevaFila(8) = proveedor&#xD;&#xA;&#xD;&#xA;        ' Calidad 3_0: columna A&#xD;&#xA;        nuevaFila(1) = fila(0).ToString().Trim()&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        ' --------------------------------------------------&#xD;&#xA;        ' PED. COMPRA: columna B (índice 1)&#xD;&#xA;        ' --------------------------------------------------&#xD;&#xA;&#xD;&#xA;        Dim compra As String = fila(1).ToString().Trim()&#xD;&#xA;&#xD;&#xA;        Dim partesCompra As String() =&#xD;&#xA;            compra.Split(New Char() {&quot;/&quot;c}, 2)&#xD;&#xA;&#xD;&#xA;        nuevaFila(2) = partesCompra(0).Trim()&#xD;&#xA;&#xD;&#xA;        If partesCompra.Length &gt; 1 Then&#xD;&#xA;            nuevaFila(3) = partesCompra(1).Trim()&#xD;&#xA;        Else&#xD;&#xA;            nuevaFila(3) = &quot;&quot;&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        ' --------------------------------------------------&#xD;&#xA;        ' COLUMNAS ESTÁNDAR&#xD;&#xA;        ' --------------------------------------------------&#xD;&#xA;&#xD;&#xA;        nuevaFila(4) = fila(2).ToString().Trim()&#xD;&#xA;        nuevaFila(5) = fila(3).ToString().Trim()&#xD;&#xA;        nuevaFila(6) = fila(4).ToString().Trim()&#xD;&#xA;        nuevaFila(7) = fila(5).ToString().Trim()&#xD;&#xA;&#xD;&#xA;        ' Colada(s): columna K&#xD;&#xA;        nuevaFila(9) = fila(10).ToString().Trim()&#xD;&#xA;&#xD;&#xA;        ' Operación: columna L&#xD;&#xA;        nuevaFila(10) = fila(11).ToString().Trim()&#xD;&#xA;&#xD;&#xA;        ' Desc. Operación: columna M&#xD;&#xA;        nuevaFila(11) = fila(12).ToString().Trim()&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        ' --------------------------------------------------&#xD;&#xA;        ' PED. VENTA: columna N (índice 13)&#xD;&#xA;        ' --------------------------------------------------&#xD;&#xA;&#xD;&#xA;        Dim venta As String = fila(13).ToString().Trim()&#xD;&#xA;&#xD;&#xA;        Dim partesVenta As String() =&#xD;&#xA;            venta.Split(New Char() {&quot;/&quot;c}, 2)&#xD;&#xA;&#xD;&#xA;        nuevaFila(12) = partesVenta(0).Trim()&#xD;&#xA;&#xD;&#xA;        If partesVenta.Length &gt; 1 Then&#xD;&#xA;            nuevaFila(13) = partesVenta(1).Trim()&#xD;&#xA;        Else&#xD;&#xA;            nuevaFila(13) = &quot;&quot;&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        ' Calidad: columna O&#xD;&#xA;        nuevaFila(14) = fila(14).ToString().Trim()&#xD;&#xA;&#xD;&#xA;        ' Cantidad: columna P&#xD;&#xA;        nuevaFila(15) = fila(15).ToString().Trim()&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        ' Agregar registro final&#xD;&#xA;        dtFinal.Rows.Add(nuevaFila)&#xD;&#xA;&#xD;&#xA;    Next&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ' ======================================================&#xD;&#xA;    ' 5. ASIGNAR RESULTADO A UIPATH&#xD;&#xA;    ' ======================================================&#xD;&#xA;&#xD;&#xA;    out_dtDatos = dtFinal&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;Catch ex As Exception&#xD;&#xA;&#xD;&#xA;    Throw New Exception(&#xD;&#xA;        &quot;Error al transformar reporte Excel: &quot; &amp;&#xD;&#xA;        ex.Message, ex)&#xD;&#xA;&#xD;&#xA;End Try" DisplayName="Invoke code to process Excel data" sap:VirtualizedContainerService.HintSize="569,197" sap2010:WorkflowViewState.IdRef="InvokeCode_6">
