    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Invoke Code (VB.NET)&#xD;&#xA;' IN:  in_dtOriginal As System.Data.DataTable&#xD;&#xA;' OUT: out_dtDatos As System.Data.DataTable&#xD;&#xA;' El archivo Excel debe leerse ANTES con Read Range Workbook (AddHeaders=True).&#xD;&#xA;&#xD;&#xA;If in_dtOriginal Is Nothing Then&#xD;&#xA;    Throw New System.Exception(&quot;El reporte ODM no fue leído: in_dtOriginal es Nothing.&quot;)&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;If in_dtOriginal.Columns.Count &lt;&gt; 17 Then&#xD;&#xA;    Dim nombres As New System.Text.StringBuilder()&#xD;&#xA;    For Each col As System.Data.DataColumn In in_dtOriginal.Columns&#xD;&#xA;        nombres.Append(&quot;[&quot; &amp; col.ColumnName &amp; &quot;] &quot;)&#xD;&#xA;    Next&#xD;&#xA;    Throw New System.Exception(&quot;Se esperaban 17 columnas y Workbook devolvió &quot; &amp; in_dtOriginal.Columns.Count.ToString() &amp; &quot;. Columnas: &quot; &amp; nombres.ToString())&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;Dim columnasFinales As String() = {&#xD;&#xA;    &quot;Proveedor Inicial&quot;, &quot;¿Calidad 3_0?&quot;, &quot;Ped. Compra&quot;, &quot;Pos. Compra&quot;,&#xD;&#xA;    &quot;Comp.Type&quot;, &quot;Material&quot;, &quot;Estado Doc.&quot;, &quot;Fecha Validación&quot;,&#xD;&#xA;    &quot;Proveedor&quot;, &quot;Colada(s)&quot;, &quot;Operación&quot;, &quot;Desc. Operación&quot;,&#xD;&#xA;    &quot;Ped. Venta&quot;, &quot;Pos. Venta&quot;, &quot;Calidad&quot;, &quot;Cantidad&quot;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Dim dtFinal As New System.Data.DataTable()&#xD;&#xA;For Each nombre As String In columnasFinales&#xD;&#xA;    dtFinal.Columns.Add(nombre, GetType(String))&#xD;&#xA;Next&#xD;&#xA;&#xD;&#xA;For Each fila As System.Data.DataRow In in_dtOriginal.Rows&#xD;&#xA;    Dim nuevaFila As System.Data.DataRow = dtFinal.NewRow()&#xD;&#xA;    Dim proveedor As String = fila(7).ToString().Trim()&#xD;&#xA;    nuevaFila(0) = proveedor&#xD;&#xA;    nuevaFila(8) = proveedor&#xD;&#xA;    nuevaFila(1) = fila(0).ToString().Trim()&#xD;&#xA;&#xD;&#xA;    Dim compra As String = fila(1).ToString().Trim()&#xD;&#xA;    Dim partesCompra As String() = compra.Split(New Char() {&quot;/&quot;c}, 2)&#xD;&#xA;    nuevaFila(2) = partesCompra(0).Trim()&#xD;&#xA;    nuevaFila(3) = If(partesCompra.Length &gt; 1, partesCompra(1).Trim(), &quot;&quot;)&#xD;&#xA;&#xD;&#xA;    nuevaFila(4) = fila(2).ToString().Trim()&#xD;&#xA;    nuevaFila(5) = fila(3).ToString().Trim()&#xD;&#xA;    nuevaFila(6) = fila(4).ToString().Trim()&#xD;&#xA;    nuevaFila(7) = fila(5).ToString().Trim()&#xD;&#xA;    nuevaFila(9) = fila(10).ToString().Trim()&#xD;&#xA;    nuevaFila(10) = fila(11).ToString().Trim()&#xD;&#xA;    nuevaFila(11) = fila(12).ToString().Trim()&#xD;&#xA;&#xD;&#xA;    Dim venta As String = fila(13).ToString().Trim()&#xD;&#xA;    Dim partesVenta As String() = venta.Split(New Char() {&quot;/&quot;c}, 2)&#xD;&#xA;    nuevaFila(12) = partesVenta(0).Trim()&#xD;&#xA;    nuevaFila(13) = If(partesVenta.Length &gt; 1, partesVenta(1).Trim(), &quot;&quot;)&#xD;&#xA;    nuevaFila(14) = fila(14).ToString().Trim()&#xD;&#xA;    nuevaFila(15) = fila(15).ToString().Trim()&#xD;&#xA;    dtFinal.Rows.Add(nuevaFila)&#xD;&#xA;Next&#xD;&#xA;&#xD;&#xA;out_dtDatos = dtFinal" DisplayName="Invoke code to process Excel data" sap:VirtualizedContainerService.HintSize="569,197" sap2010:WorkflowViewState.IdRef="InvokeCode_7">
