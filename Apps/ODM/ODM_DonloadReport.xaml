    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Variables de entrada/salida asumidas:&#xD;&#xA;' in_CsvFilePath (String) -&gt; Ruta del archivo CSV descargado&#xD;&#xA;' out_dtResultado (DataTable) -&gt; DataTable final con el formato requerido&#xD;&#xA;&#xD;&#xA;Dim lines As String() = System.IO.File.ReadAllLines(in_CsvFilePath, System.Text.Encoding.UTF8)&#xD;&#xA;&#xD;&#xA;' 1. Crear la DataTable con el esquema final requerido en el orden exacto (Punto 6)&#xD;&#xA;Dim dt As New DataTable()&#xD;&#xA;&#xD;&#xA;' Definición de las columnas de destino&#xD;&#xA;dt.Columns.Add(&quot;Proveedor Inicial&quot;, GetType(String))                   ' Columna A (Original Proveedor 1)&#xD;&#xA;dt.Columns.Add(&quot;¿Calidad 3_0?&quot;, GetType(String))                       ' Columna B (Punto 1)&#xD;&#xA;dt.Columns.Add(&quot;Ped. Compra&quot;, GetType(String))                         ' Punto 2&#xD;&#xA;dt.Columns.Add(&quot;Pos. Compra&quot;, GetType(String))                         ' Punto 2&#xD;&#xA;dt.Columns.Add(&quot;Comp.Type&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;Material&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;Indicador de Estado de Documentación&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;Fecha Validación&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;Proveedor&quot;, GetType(String))                           ' Punto 3 (Original Proveedor 2 - Col H)&#xD;&#xA;dt.Columns.Add(&quot;Colada(s)&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;Operación&quot;, GetType(String))                           ' Punto 5&#xD;&#xA;dt.Columns.Add(&quot;Desc. Operación&quot;, GetType(String))                     ' Punto 5&#xD;&#xA;dt.Columns.Add(&quot;Ped. Venta&quot;, GetType(String))                          ' Punto 2&#xD;&#xA;dt.Columns.Add(&quot;Pos. Venta&quot;, GetType(String))                          ' Punto 2&#xD;&#xA;dt.Columns.Add(&quot;Calidad&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;Cantidad&quot;, GetType(String))&#xD;&#xA;&#xD;&#xA;' 2. Procesar el archivo CSV línea por línea&#xD;&#xA;For i As Integer = 1 To lines.Length - 1&#xD;&#xA;    Dim line As String = lines(i).Trim()&#xD;&#xA;    If String.IsNullOrWhiteSpace(line) Then Continue For&#xD;&#xA;    &#xD;&#xA;    ' Separar campos por coma respetando la estructura&#xD;&#xA;    Dim fields As String() = line.Split(New String() {&quot;,&quot;}, StringSplitOptions.None)&#xD;&#xA;    &#xD;&#xA;    ' Limpiar comillas dobles residuales&#xD;&#xA;    For j As Integer = 0 To fields.Length - 1&#xD;&#xA;        fields(j) = fields(j).Replace(&quot;&quot;&quot;&quot;, &quot;&quot;).Trim()&#xD;&#xA;    Next&#xD;&#xA;    &#xD;&#xA;    ' Verificar que existan las columnas mínimas del CSV&#xD;&#xA;    If fields.Length &gt;= 8 Then&#xD;&#xA;        Dim row As DataRow = dt.NewRow()&#xD;&#xA;        &#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        ' Columna A: Proveedor Inicial (Tomado del primer &quot;Proveedor&quot; - Columna 0)&#xD;&#xA;        row(&quot;Proveedor Inicial&quot;) = fields(0)&#xD;&#xA;        &#xD;&#xA;        ' Columna B: ¿Calidad 3_0? (Punto 1: Por defecto &quot;-&quot;)&#xD;&#xA;        row(&quot;¿Calidad 3_0?&quot;) = &quot;-&quot;&#xD;&#xA;        &#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        ' Punto 2: Separar Ped. Compra / Pos. Compra (Columna 1 original)&#xD;&#xA;        Dim rawPedCompra As String = If(fields.Length &gt; 1, fields(1), &quot;&quot;)&#xD;&#xA;        Dim pedCompraVal As String = rawPedCompra&#xD;&#xA;        Dim posCompraVal As String = &quot;&quot;&#xD;&#xA;        If rawPedCompra.Contains(&quot;/&quot;) Then&#xD;&#xA;            Dim partsPC As String() = rawPedCompra.Split(&quot;/&quot;c)&#xD;&#xA;            pedCompraVal = partsPC(0).Trim()&#xD;&#xA;            posCompraVal = partsPC(1).Trim()&#xD;&#xA;        End If&#xD;&#xA;        row(&quot;Ped. Compra&quot;) = pedCompraVal&#xD;&#xA;        row(&quot;Pos. Compra&quot;) = posCompraVal&#xD;&#xA;        &#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        ' Columnas Estándar&#xD;&#xA;        row(&quot;Comp.Type&quot;) = If(fields.Length &gt; 2, fields(2), &quot;&quot;)&#xD;&#xA;        row(&quot;Material&quot;) = If(fields.Length &gt; 3, fields(3), &quot;&quot;)&#xD;&#xA;        row(&quot;Indicador de Estado de Documentación&quot;) = If(fields.Length &gt; 4, fields(4), &quot;&quot;)&#xD;&#xA;        row(&quot;Fecha Validación&quot;) = If(fields.Length &gt; 5, fields(5), &quot;&quot;)&#xD;&#xA;        &#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        ' Punto 3: Proveedor Real (Tomado del segundo &quot;Proveedor&quot; - Columna 7 original)&#xD;&#xA;        row(&quot;Proveedor&quot;) = fields(7)&#xD;&#xA;        &#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        ' Colada(s) (Columna 10 original)&#xD;&#xA;        row(&quot;Colada(s)&quot;) = If(fields.Length &gt; 10, fields(10), &quot;&quot;)&#xD;&#xA;        &#xD;&#xA;        ' Punto 5: Operación y Desc. Operación (Valores vacíos si no existen)&#xD;&#xA;        row(&quot;Operación&quot;) = &quot;&quot;&#xD;&#xA;        row(&quot;Desc. Operación&quot;) = &quot;&quot;&#xD;&#xA;        &#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        ' Punto 2: Separar Ped. Venta / Pos. Venta (Columna 11 original)&#xD;&#xA;        Dim rawPedVenta As String = If(fields.Length &gt; 11, fields(11), &quot;&quot;)&#xD;&#xA;        Dim pedVentaVal As String = rawPedVenta&#xD;&#xA;        Dim posVentaVal As String = &quot;&quot;&#xD;&#xA;        If rawPedVenta.Contains(&quot;/&quot;) Then&#xD;&#xA;            Dim partsPV As String() = rawPedVenta.Split(&quot;/&quot;c)&#xD;&#xA;            pedVentaVal = partsPV(0).Trim()&#xD;&#xA;            posVentaVal = partsPV(1).Trim()&#xD;&#xA;        End If&#xD;&#xA;        row(&quot;Ped. Venta&quot;) = pedVentaVal&#xD;&#xA;        row(&quot;Pos. Venta&quot;) = posVentaVal&#xD;&#xA;        &#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        ' Calidad y Cantidad&#xD;&#xA;        row(&quot;Calidad&quot;) = If(fields.Length &gt; 12, fields(12), &quot;&quot;)&#xD;&#xA;        row(&quot;Cantidad&quot;) = If(fields.Length &gt; 13, fields(13), &quot;&quot;)&#xD;&#xA;        &#xD;&#xA;        ' Agregar fila mapeada a la tabla final&#xD;&#xA;        dt.Rows.Add(row)&#xD;&#xA;    End If&#xD;&#xA;Next&#xD;&#xA;&#xD;&#xA;' Puntos 4 y 7: Al construir directamente 'dt' con las columnas requeridas,&#xD;&#xA;' se omiten y eliminan automáticamente columnas como &quot;validacionCompras.usuarioValidador&quot;,&#xD;&#xA;' &quot;validacionCompras.fechaEntrega&quot;, &quot;ORG. COMPRAS&quot;, &quot;Cantidad Parcial Entregada&quot;, &quot;Acciones&quot; y cualquier otra adicional.&#xD;&#xA;&#xD;&#xA;out_dtResultado = dt" DisplayName="Process CSV data for spare parts tracking report" sap:VirtualizedContainerService.HintSize="569,197" sap2010:WorkflowViewState.IdRef="InvokeCode_4">
