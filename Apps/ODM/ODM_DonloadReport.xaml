    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' UiPath Invoke Code - VB.NET&#xD;&#xA;' Entrada:  in_RutaExcel As String&#xD;&#xA;' Salida:   out_RutaNormalizada As String&#xD;&#xA;'           out_Correcciones As Int32&#xD;&#xA;&#xD;&#xA;Dim origen As String = in_RutaExcel&#xD;&#xA;&#xD;&#xA;If String.IsNullOrWhiteSpace(origen) OrElse&#xD;&#xA;   Not System.IO.File.Exists(origen) Then&#xD;&#xA;    Throw New System.IO.FileNotFoundException(&#xD;&#xA;        &quot;No se encontró el archivo ODM.&quot;, origen)&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;Dim carpeta As String = System.IO.Path.GetDirectoryName(origen)&#xD;&#xA;Dim nombre As String = System.IO.Path.GetFileNameWithoutExtension(origen)&#xD;&#xA;&#xD;&#xA;Dim destino As String = System.IO.Path.Combine(&#xD;&#xA;    carpeta, nombre &amp; &quot;_Normalizado.xlsx&quot;)&#xD;&#xA;&#xD;&#xA;Dim temporal As String = System.IO.Path.Combine(&#xD;&#xA;    carpeta, System.Guid.NewGuid().ToString(&quot;N&quot;) &amp; &quot;.tmp&quot;)&#xD;&#xA;&#xD;&#xA;out_RutaNormalizada = Nothing&#xD;&#xA;out_Correcciones = 0&#xD;&#xA;&#xD;&#xA;Try&#xD;&#xA;    Using archivoOrigen As New System.IO.FileStream(&#xD;&#xA;        origen, System.IO.FileMode.Open,&#xD;&#xA;        System.IO.FileAccess.Read, System.IO.FileShare.Read)&#xD;&#xA;&#xD;&#xA;        Using zipOrigen As New System.IO.Compression.ZipArchive(&#xD;&#xA;            archivoOrigen,&#xD;&#xA;            System.IO.Compression.ZipArchiveMode.Read)&#xD;&#xA;&#xD;&#xA;            Using archivoTemporal As New System.IO.FileStream(&#xD;&#xA;                temporal, System.IO.FileMode.CreateNew,&#xD;&#xA;                System.IO.FileAccess.Write, System.IO.FileShare.None)&#xD;&#xA;&#xD;&#xA;                Using zipDestino As New System.IO.Compression.ZipArchive(&#xD;&#xA;                    archivoTemporal,&#xD;&#xA;                    System.IO.Compression.ZipArchiveMode.Create)&#xD;&#xA;&#xD;&#xA;                    Dim estilosEncontrados As Boolean = False&#xD;&#xA;&#xD;&#xA;                    For Each entrada As System.IO.Compression.ZipArchiveEntry In zipOrigen.Entries&#xD;&#xA;&#xD;&#xA;                        If entrada.FullName = &quot;xl/styles.xml&quot; Then&#xD;&#xA;&#xD;&#xA;                            estilosEncontrados = True&#xD;&#xA;&#xD;&#xA;                            Dim contenido As String&#xD;&#xA;&#xD;&#xA;                            Using lector As New System.IO.StreamReader(&#xD;&#xA;                                entrada.Open(),&#xD;&#xA;                                New System.Text.UTF8Encoding(False))&#xD;&#xA;&#xD;&#xA;                                contenido = lector.ReadToEnd()&#xD;&#xA;                            End Using&#xD;&#xA;&#xD;&#xA;                            Dim patron As String =&#xD;&#xA;                                &quot;\breadingOrder\s*=\s*(['&quot;&quot;])\s*\1&quot;&#xD;&#xA;&#xD;&#xA;                            out_Correcciones =&#xD;&#xA;                                System.Text.RegularExpressions.Regex.Matches(&#xD;&#xA;                                    contenido, patron).Count&#xD;&#xA;&#xD;&#xA;                            contenido =&#xD;&#xA;                                System.Text.RegularExpressions.Regex.Replace(&#xD;&#xA;                                    contenido, patron, &quot;readingOrder=&quot;&quot;0&quot;&quot;&quot;)&#xD;&#xA;&#xD;&#xA;                            Dim nuevaEntrada = zipDestino.CreateEntry(&#xD;&#xA;                                entrada.FullName,&#xD;&#xA;                                System.IO.Compression.CompressionLevel.Optimal)&#xD;&#xA;&#xD;&#xA;                            Using escritor As New System.IO.StreamWriter(&#xD;&#xA;                                nuevaEntrada.Open(),&#xD;&#xA;                                New System.Text.UTF8Encoding(False))&#xD;&#xA;&#xD;&#xA;                                escritor.Write(contenido)&#xD;&#xA;                            End Using&#xD;&#xA;&#xD;&#xA;                        Else&#xD;&#xA;&#xD;&#xA;                            Dim nuevaEntrada = zipDestino.CreateEntry(&#xD;&#xA;                                entrada.FullName,&#xD;&#xA;                                System.IO.Compression.CompressionLevel.Optimal)&#xD;&#xA;&#xD;&#xA;                            Using entradaOrigen = entrada.Open()&#xD;&#xA;                                Using entradaDestino = nuevaEntrada.Open()&#xD;&#xA;                                    entradaOrigen.CopyTo(entradaDestino)&#xD;&#xA;                                End Using&#xD;&#xA;                            End Using&#xD;&#xA;&#xD;&#xA;                        End If&#xD;&#xA;&#xD;&#xA;                    Next&#xD;&#xA;&#xD;&#xA;                    If Not estilosEncontrados Then&#xD;&#xA;                        Throw New Exception(&#xD;&#xA;                            &quot;El XLSX no contiene xl/styles.xml.&quot;)&#xD;&#xA;                    End If&#xD;&#xA;&#xD;&#xA;                End Using&#xD;&#xA;            End Using&#xD;&#xA;        End Using&#xD;&#xA;    End Using&#xD;&#xA;&#xD;&#xA;    ' Comprobar que la copia se puede abrir como ZIP.&#xD;&#xA;    Using validacion As System.IO.Compression.ZipArchive =&#xD;&#xA;        System.IO.Compression.ZipFile.OpenRead(temporal)&#xD;&#xA;&#xD;&#xA;        If validacion.GetEntry(&quot;xl/workbook.xml&quot;) Is Nothing OrElse&#xD;&#xA;           validacion.GetEntry(&quot;xl/styles.xml&quot;) Is Nothing Then&#xD;&#xA;&#xD;&#xA;            Throw New Exception(&#xD;&#xA;                &quot;La copia no contiene los componentes XLSX esperados.&quot;)&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;    End Using&#xD;&#xA;&#xD;&#xA;    ' No sobrescribir una copia anterior.&#xD;&#xA;    If System.IO.File.Exists(destino) Then&#xD;&#xA;        destino = System.IO.Path.Combine(&#xD;&#xA;            carpeta,&#xD;&#xA;            nombre &amp; &quot;_Normalizado_&quot; &amp;&#xD;&#xA;            System.DateTime.Now.ToString(&quot;yyyyMMdd_HHmmssfff&quot;) &amp;&#xD;&#xA;            &quot;.xlsx&quot;)&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    System.IO.File.Move(temporal, destino)&#xD;&#xA;    out_RutaNormalizada = destino&#xD;&#xA;&#xD;&#xA;Catch&#xD;&#xA;    If System.IO.File.Exists(temporal) Then&#xD;&#xA;        System.IO.File.Delete(temporal)&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    Throw&#xD;&#xA;End Try" DisplayName="Process report, normalize path, and count corrections." sap:VirtualizedContainerService.HintSize="569,197" sap2010:WorkflowViewState.IdRef="InvokeCode_8">
