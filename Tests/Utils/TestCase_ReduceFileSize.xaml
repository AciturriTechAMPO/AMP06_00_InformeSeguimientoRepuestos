nual&#xA;&#xA;    ' ==============================================&#xA;    ' 4. OBTENER HOJA INFORME DATOS&#xA;    ' ==============================================&#xA;&#xA;    etapa = &quot;Obtener hoja INFORME datos&quot;&#xA;&#xA;    For intento As Integer = 1 To 15&#xA;&#xA;        Try&#xA;&#xA;            hojaDatos = CType(&#xA;                libro.Worksheets.Item(&quot;INFORME datos&quot;),&#xA;                Microsoft.Office.Interop.Excel.Worksheet)&#xA;&#xA;            Exit For&#xA;&#xA;        Catch ex As System.Runtime.InteropServices.COMException&#xA;&#xA;            If ex.ErrorCode &lt;&gt; -2147418111 OrElse intento = 15 Then&#xA;                Throw&#xA;            End If&#xA;&#xA;            System.Threading.Thread.Sleep(3000)&#xA;&#xA;        End Try&#xA;&#xA;    Next&#xA;&#xA;    ' ==============================================&#xA;    ' 5. VALIDAR HOJAS QUE SE CONSERVAN&#xA;    ' ==============================================&#xA;&#xA;    etapa = &quot;Validar hojas&quot;&#xA;&#xA;    Dim hojasConservar As String() = {&#xA;        &quot;INFORME datos&quot;,&#xA;        &quot;Informe por pedido&quot;,&#xA;        &quot;Informe por posicion&quot;&#xA;    }&#xA;&#xA;    For Each nombre As String In hojasConservar&#xA;&#xA;        Dim encontrada As Boolean = False&#xA;&#xA;        For i As Integer = 1 To libro.Worksheets.Count&#xA;&#xA;            Dim hoja As Microsoft.Office.Interop.Excel.Worksheet =&#xA;                CType(libro.Worksheets.Item(i),&#xA;                Microsoft.Office.Interop.Excel.Worksheet)&#xA;&#xA;            If System.String.Equals(&#xA;                hoja.Name,&#xA;                nombre,&#xA;                System.StringComparison.OrdinalIgnoreCase) Then&#xA;&#xA;                encontrada = True&#xA;&#xA;            End If&#xA;&#xA;            System.Runtime.InteropServices.Marshal.ReleaseComObject(hoja)&#xA;&#xA;            If encontrada Then Exit For&#xA;&#xA;        Next&#xA;&#xA;        If Not encontrada Then&#xA;  