rosoft.Office.Interop.Excel.Worksheet)&#xD;&#xA;&#xD;&#xA;        Dim conservar As Boolean = False&#xD;&#xA;&#xD;&#xA;        For Each nombre As String In hojasConservar&#xD;&#xA;&#xD;&#xA;            If System.String.Equals(&#xD;&#xA;                hoja.Name,&#xD;&#xA;                nombre,&#xD;&#xA;                System.StringComparison.OrdinalIgnoreCase) Then&#xD;&#xA;&#xD;&#xA;                conservar = True&#xD;&#xA;                Exit For&#xD;&#xA;&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;        Next&#xD;&#xA;&#xD;&#xA;        If Not conservar Then&#xD;&#xA;            hoja.Delete()&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        System.Runtime.InteropServices.Marshal.ReleaseComObject(hoja)&#xD;&#xA;&#xD;&#xA;    Next&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;' ==============================================&#xD;&#xA;&#x9;' 9. CONFIGURAR GUARDADO SIN RECALCULAR&#xD;&#xA;&#x9;' ==============================================&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;etapa = &quot;Configurar guardado&quot;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;' Mantener cálculo manual&#xD;&#xA;&#x9;excel.Calculation = Microsoft.Office.Interop.Excel.XlCalculation.xlCalculationManual&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;' Evitar eventos VBA durante el guardado&#xD;&#xA;&#x9;excel.EnableEvents = False&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;' Evitar cuadros de diálogo de Excel&#xD;&#xA;&#x9;excel.DisplayAlerts = False&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;' ==============================================&#xD;&#xA;&#x9;' 10. GUARDAR MISMO ARCHIVO&#xD;&#xA;&#x9;' ==============================================&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;etapa = &quot;Guardar archivo XLSM&quot;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;libro.Save()&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;guardado = True&#xD;&#xA;&#xD;&#xA;Catch ex As System.Exception&#xD;&#xA;&#xD;&#xA;    Throw New System.Exception(&#xD;&#xA;        &quot;ERROR INVOKE CODE&quot; &amp;&#xD;&#xA;        System.Environment.NewLine &amp;&#xD;&#xA;        &quot;Etapa: &quot; &amp; etapa &amp;&#x